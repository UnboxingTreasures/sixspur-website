{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTableAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/orders"
    },
    {
      "Sid": "OrdersQueryByDonor",
      "Effect": "Allow",
      "Action": ["dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:658965339779:table/orders",
        "arn:aws:dynamodb:us-east-1:658965339779:table/orders/index/donorId-index"
      ]
    },
    {
      "Sid": "ShopItemsStockAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/shop_items"
    },
    {
      "Sid": "ShopSettingsRead",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/shop_settings"
    },
    {
      "Sid": "SmsRecipientsRead",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/sms_recipients"
    },
    {
      "Sid": "PayPalSecretAccess",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:658965339779:secret:sixspur/paypal-api-*"
    },
    {
      "Sid": "SendOrderSms",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "*"
    },
    {
      "Sid": "Logging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:658965339779:*"
    }
  ]
}
