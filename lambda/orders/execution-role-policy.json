{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTableAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/orders"
    },
    {
      "Sid": "ShopItemsStockAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/shop_items"
    },
    {
      "Sid": "PayPalSecretAccess",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:658965339779:secret:sixspur/paypal-api-*"
    }
  ]
}
