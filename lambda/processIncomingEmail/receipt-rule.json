{
  "Name": "sixspur-inbound-to-processor",
  "Enabled": true,
  "TlsPolicy": "Optional",
  "Recipients": ["richard@sixspurranch.org"],
  "ScanEnabled": true,
  "Actions": [
    {
      "S3Action": {
        "BucketName": "sixspurranch-incoming-mail"
      }
    },
    {
      "LambdaAction": {
        "FunctionArn": "arn:aws:lambda:us-east-1:658965339779:function:sixspur-processIncomingEmail",
        "InvocationType": "Event"
      }
    }
  ]
}
