{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NewsPostsReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:658965339779:table/news_posts",
        "arn:aws:dynamodb:us-east-1:658965339779:table/news_posts/index/*"
      ]
    },
    {
      "Sid": "BlogCommentsReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:658965339779:table/blog_comments",
        "arn:aws:dynamodb:us-east-1:658965339779:table/blog_comments/index/*"
      ]
    },
    {
      "Sid": "DonorsTableReadForCommentName",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/donors"
    },
    {
      "Sid": "AssetsBucketPhotoWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::sixspurranch-assets/images/news/*"
    },
    {
      "Sid": "Logging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:658965339779:*"
    }
  ]
}
