{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdoptableAnimalsReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:Scan", "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:658965339779:table/adoptable_animals"
    },
    {
      "Sid": "AssetsBucketPhotoWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::sixspurranch-assets/images/adoptable/*"
    },
    {
      "Sid": "Logging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:658965339779:*"
    }
  ]
}
