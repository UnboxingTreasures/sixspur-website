{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdoptionApplicationsReadWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem", "dynamodb:Scan", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:658965339779:table/adoption_applications",
        "arn:aws:dynamodb:us-east-1:658965339779:table/adoption_applications/index/status-index"
      ]
    },
    {
      "Sid": "PdfBucketRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::sixspurranch-adoption-pdfs/*"
    },
    {
      "Sid": "SESSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    },
    {
      "Sid": "Logging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:658965339779:*"
    }
  ]
}
